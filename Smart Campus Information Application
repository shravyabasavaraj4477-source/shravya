# MAIN SYSTEM APPLICATION DASHBOARD
# -----------------------------------------------------------------
def dashboard():
    while True:
        print("\n" + "="*45)
        print("    SMART CAMPUS SYSTEM MENU")
        print("="*45)
        print("1. Register Student & Evaluate Grade (Lab 1)")
        print("2. Course Enrollment Manager (Lab 2)")
        print("3. View Memory Records & Event Sets (Lab 3)")
        print("4. Search Student Profile by ID (Lab 4)")
        print("5. Run Fee Assessment Engine (Lab 5)")
        print("6. Export Student Records to Text File (Lab 6)")
        print("7. Scan Local System Folders (Lab 7)")
        print("8. Display Performance Analytics Chart (Lab 8)")
        print("9. Shutdown Application")
        print("="*45)
        
        choice = input("Select an option (1-9): ").strip()
        
        if choice == "1":
            print("\n--- Student Registration ---")
            try:
                s_id = int(input("Enter Student ID (Numbers only): "))
                name = input("Enter Student Name: ").strip()
                score = float(input("Enter Exam Score (0-100): "))
                
                grade, remark = check_grade(score)
                
                # Append student data dict to global list
                students_db.append({
                    "id": s_id,
                    "name": name,
                    "score": score,
                    "grade": grade,
                    "courses": []
                })
                print(f"Student {name} registered! Evaluated Grade: {grade} ({remark})")
            except ValueError:
                print("[Input Error]: Please insert numbers where required.")

        elif choice == "2":
            print("\n--- Course Enrollment Management ---")
            if not students_db:
                print("No students profiles loaded yet. Add one first via option 1.")
                continue
            
            # Pick the first student profile in memory for ease of demonstration
            student = students_db[0]
            print(f"Managing course selection for: {student['name']} (ID: {student['id']})")
            
            # Simple loop rule tracking (max 3 courses allowed in this simple version)
            while len(student['courses']) < 3:
                course = input("Enter a course title (or type 'done' to stop): ").strip()
                if course.lower() == 'done':
                    break
                if course:
                    student['courses'].append(course)
                    print(f"-> Linked '{course}' successfully.")
            print(f"Current enrolled list: {student['courses']}")

        elif choice == "3":
            print("\n--- In-Memory Data Records Overview ---")
            print("Registered Students:", students_db)
            print("\n--- Campus Group Memberships (Sets Operations) ---")
            print("Sports Group:", sports_set)
            print("Cultural Group:", cultural_set)
            print("Students in BOTH groups:", sports_set.intersection(cultural_set))

        elif choice == "4":
            print("\n--- Search and Sorting System ---")
            if not students_db:
                print("Database is empty. Populate profiles first.")
                continue
            try:
                search_id = int(input("Enter Student ID to find: "))
                sort_students_by_id() # Ensure data is sorted first
                
                found_idx = binary_search_student(search_id)
                if found_idx != -1:
                    match = students_db[found_idx]
                    print(f"[Match Found!]: Name: {match['name']}, Grade: {match['grade']}")
                else:
                    print("Student ID not found in records registry.")
            except ValueError:
                print("Invalid input value.")

        elif choice == "5":
            print("\n--- Fee Calculation Subsystem ---")
            try:
                base_fee = float(input("Enter Tuition Base amount: "))
                hostel_fee = float(input("Enter Hostel Charge (Enter 0 if None): "))
                total = calculate_total_fee(base_fee, hostel_fee)
                print(f"Net Student Dues Balance: {total} INR")
            except ValueError:
                print("Numerical configuration parsing error.")

        elif choice == "6":
            save_data_to_file()

        elif choice == "7":
            path_to_check = input("\nEnter a path folder directory to scan (e.g., '.' for current folder): ").strip()
            scan_folder(path_to_check)

        elif choice == "8":
            run_analytics()

        elif choice == "9":
            print("\nClosing Smart Campus application dashboard. Goodbye!")
            break
        else:
            print("Invalid input sequence option. Please select 1 through 9.")

# Start execution
if __name__ == "__main__":
    dashboard()
