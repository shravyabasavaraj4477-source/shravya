# LAB 1: Grade Evaluator
def check_grade(score):
    if score >= 90: return "A", "Excellent"
    elif score >= 75: return "B", "Very Good"
    elif score >= 60: return "C", "Good"
    elif score >= 40: return "D", "Average"
    else: return "F", "Needs Improvement"

# LAB 5: Fee Calculation Function
def calculate_total_fee(tuition, hostel=0, transport=0):
    return tuition + hostel + transport

# LAB 4: Sorting & Searching (Bubble Sort & Binary Search)
def sort_students_by_id():
    n = len(students_db)
    for i in range(n):
        for j in range(0, n - i - 1):
            if students_db[j]['id'] > students_db[j+1]['id']:
                # Swap elements
                students_db[j], students_db[j+1] = students_db[j+1], students_db[j]

def binary_search_student(target_id):
    low = 0
    high = len(students_db) - 1
    while low <= high:
        mid = (low + high) // 2
        if students_db[mid]['id'] == target_id:
            return mid  # Target index found
        elif students_db[mid]['id'] < target_id:
            low = mid + 1
        else:
            high = mid - 1
    return -1  # Target not found

# LAB 6: File Management (Save data to file)
def save_data_to_file():
    try:
        with open("campus_records.txt", "w") as file:
            file.write("ID,Name,Score,Grade\n")
            for s in students_db:
                file.write(f"{s['id']},{s['name']},{s['score']},{s['grade']}\n")
        print("\n[Success] Records successfully written to 'campus_records.txt'!")
    except Exception as e:
        print(f"File write operation failed: {e}")

# LAB 7: Directory Scanning with Exception Handling
def scan_folder(folder_path):
    try:
        if not os.path.exists(folder_path):
            raise FileNotFoundError(f"The path '{folder_path}' does not exist.")
        
        print(f"\n--- Scanning Contents of: {folder_path} ---")
        for item in os.listdir(folder_path):
            print(f" -> {item}")
    except FileNotFoundError as err:
        print(f"[Error Handled]: {err}")
    except Exception as err:
        print(f"[Unexpected Error]: {err}")

# LAB 8: Simplified Performance Analytics (Data Tools)
def run_analytics():
    csv_file = "student_performance.csv"
    
    # Auto-generate a dummy CSV file if it doesn't exist yet to guarantee execution
    if not os.path.exists(csv_file):
        dummy_data = {
            "Name": ["Amit", "Rahul", "Priya", "Sneha", "Kiran"],
            "Math": [88, 72, 95, 61, 84],
            "Science": [92, 81, 89, 70, 78],
            "English": [79, 85, 91, 65, 88]
        }
        pd.DataFrame(dummy_data).to_csv(csv_file, index=False)
        print(f"[Info] Generated a sample data sheet '{csv_file}' for analysis.")

    try:
        # 1. Pandas Operations
        df = pd.read_csv(csv_file)
        print("\n--- Student Dataset (Pandas Dataframe) ---")
        print(df)
        
        # 2. NumPy Operations
        subjects = ["Math", "Science", "English"]
        num_matrix = df[subjects].to_numpy()
        
        print("\n--- Class performance Statistics (NumPy) ---")
        averages = np.mean(num_matrix, axis=0)
        for i, sub in enumerate(subjects):
            print(f"Average score in {sub}: {averages[i]:.1f}")
            
        # 3. Matplotlib Visual Chart
        print("\n[Visualizer] Generating chart window...")
        plt.figure(figsize=(6, 4))
        plt.bar(subjects, averages, color=['skyblue', 'lightgreen', 'coral'])
        plt.title("Class Averages Overview")
        plt.ylabel("Scores")
        plt.ylim(0, 100)
        plt.show()
        
    except Exception as e:
        print(f"Analytics Pipeline Error: {e}")


